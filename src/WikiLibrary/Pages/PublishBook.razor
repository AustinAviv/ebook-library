@page "/publish"
@inject SupabaseService Supabase
@inject NavigationManager Nav
@inject BookService Books
@implements IDisposable

<PageTitle>Submit Books - Aviv Library</PageTitle>

<div class="publish-container">
    <nav class="book-breadcrumb">
        <a href="/">← Library</a>
        <span class="crumb-separator">/</span>
        <span class="crumb-current">Submit Books</span>
    </nav>

    @if (submittedSuccessfully && uploadedSubmissions.Count > 0)
    {
        <div class="submission-success-card">
            <div class="success-icon-box">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
            </div>
            <h2>@uploadedSubmissions.Count Book@(uploadedSubmissions.Count == 1 ? "" : "s") Submitted for Review!</h2>
            <p class="muted">
                Thank you for contributing to Aviv Library. Your submissions have been uploaded to storage and queued for owner review.
            </p>

            <div class="upload-file-list" style="margin: 20px 0; text-align: left;">
                @foreach (var sub in uploadedSubmissions)
                {
                    <div class="upload-file-item uploaded">
                        <div class="upload-file-info">
                            <div class="upload-file-icon" style="color:#16a34a;">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                </svg>
                            </div>
                            <div>
                                <strong style="display:block;color:var(--text-primary);">@sub.Title</strong>
                                <span class="muted" style="font-size:0.75rem;">@sub.FileSizeText • Pending Review</span>
                            </div>
                        </div>
                        <span class="upload-status-badge uploaded">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>Queued</span>
                        </span>
                    </div>
                }
            </div>

            <div class="success-actions">
                <a href="/my-submissions" class="btn-action-primary">Track in My Submissions</a>
                <button type="button" class="btn-action-secondary" @onclick="ResetUploader">Upload More Books</button>
            </div>
        </div>
    }
    else if (!Supabase.IsInitialized)
    {
        <div class="submissions-loading" style="padding:60px 20px;text-align:center;">
            <div class="loader-spinner"></div>
            <p class="muted" style="margin-top:16px;">Verifying authentication status...</p>
        </div>
    }
    else if (!Supabase.IsAuthenticated)
    {
        <div class="owner-auth-card" style="margin-top:20px;">
            <div class="lock-icon-box">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            </div>
            <h2>Sign In Required to Submit Books</h2>
            <p class="muted">
                To prevent spam and allow you to track your publications, please sign in before uploading books.
            </p>

            @if (!string.IsNullOrWhiteSpace(loginError))
            {
                <div class="auth-alert error" style="margin-top:16px;">@loginError</div>
            }

            <form class="owner-login-form" @onsubmit="HandleUserLogin" @onsubmit:preventDefault>
                <div class="form-group">
                    <label for="publish-email">Email Address</label>
                    <input id="publish-email" type="email" class="form-input" placeholder="you@example.com"
                           required @bind="authEmail" disabled="@isAuthenticating" />
                </div>

                <div class="form-group">
                    <label for="publish-pass">Password</label>
                    <input id="publish-pass" type="password" class="form-input" placeholder="••••••••"
                           required @bind="authPassword" disabled="@isAuthenticating" />
                </div>

                <div style="display:flex;gap:12px;margin-top:16px;">
                    <button type="submit" class="btn-action-primary" style="flex:1;" disabled="@isAuthenticating">
                        @(isAuthenticating ? "Signing In..." : "Sign In & Continue")
                    </button>
                    <button type="button" class="btn-action-secondary" @onclick="HandleUserSignUp" disabled="@isAuthenticating">
                        Sign Up
                    </button>
                </div>
            </form>
        </div>
    }
    else
    {
        <header class="publish-header">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;">
                <div>
                    <h1 class="page-title">Submit Books to the Library</h1>
                    <p class="lead-text">
                        Select one or multiple PDF books to submit directly for publication review.
                    </p>
                </div>
                <div class="user-pill-dropdown" style="margin-top:4px;">
                    <span class="user-email-pill" title="@Supabase.CurrentUser?.Email" style="display:inline-flex;align-items:center;gap:6px;">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink:0;">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <span>@Supabase.CurrentUser?.Email</span>
                        @if (!string.IsNullOrWhiteSpace(Supabase.CurrentUser?.Uid))
                        {
                            <span class="user-uid-code">#@Supabase.CurrentUser.Uid</span>
                        }
                    </span>
                </div>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="auth-alert error" style="margin-bottom: 24px;">
                @errorMessage
            </div>
        }

        <div class="form-section-card">
            <div class="file-dropzone-wrapper">
                <input type="file" id="book-upload-input" accept="application/pdf,.pdf" multiple
                       class="file-native-input" @onchange="OnFilesSelected" disabled="@isUploading" />
                <label for="book-upload-input" class="file-dropzone-label">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="17 8 12 3 7 8"></polyline>
                        <line x1="12" y1="3" x2="12" y2="15"></line>
                    </svg>
                    <span class="dropzone-prompt"><strong>Choose PDF Books</strong> or drag &amp; drop here</span>
                    <span class="dropzone-sub">You can select multiple PDF files at once (up to 50 MB each)</span>
                </label>
            </div>

            @if (selectedItems.Count > 0)
            {
                <div class="upload-files-summary">
                    <div>
                        <strong style="color:var(--text-primary);">@selectedItems.Count Book@(selectedItems.Count == 1 ? "" : "s") Selected</strong>
                        <span class="muted" style="margin-left:8px;font-size:0.8125rem;">(@TotalSelectedSizeText total)</span>
                    </div>
                    @if (!isUploading)
                    {
                        <button type="button" class="btn-action-secondary btn-sm" @onclick="ClearSelected">
                            Clear List
                        </button>
                    }
                </div>

                <div class="upload-file-list">
                    @foreach (var item in selectedItems)
                    {
                        <div class="upload-file-item @item.Status">
                            <div class="upload-file-info">
                                <div class="upload-file-icon">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                        <polyline points="14 2 14 8 20 8"></polyline>
                                    </svg>
                                </div>
                                <div style="flex:1;min-width:0;">
                                    @if (item.Status == "ready")
                                    {
                                        <input type="text" class="upload-file-title-input" @bind="item.Title" placeholder="Book Title" disabled="@isUploading" />
                                    }
                                    else
                                    {
                                        <strong style="display:block;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@item.Title</strong>
                                    }
                                    <div class="upload-file-meta">
                                        <span>@item.FileName</span>
                                        <span>•</span>
                                        <span>@item.FileSizeText</span>
                                        @if (!string.IsNullOrWhiteSpace(item.ErrorMessage))
                                        {
                                            <span style="color:#dc2626;">• @item.ErrorMessage</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div style="display:flex;align-items:center;gap:10px;">
                                @if (item.Status == "ready")
                                {
                                    <span class="upload-status-badge ready">Ready</span>
                                    @if (!isUploading)
                                    {
                                        <button type="button" class="btn-remove-file" @onclick="() => RemoveItem(item)" title="Remove file">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>
                                        </button>
                                    }
                                }
                                else if (item.Status == "uploading")
                                {
                                    <span class="upload-status-badge uploading">
                                        <div class="btn-spinner" style="width:12px;height:12px;border-width:1.5px;"></div>
                                        <span>Uploading...</span>
                                    </span>
                                }
                                else if (item.Status == "uploaded")
                                {
                                    <span class="upload-status-badge uploaded">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                        <span>Submitted</span>
                                    </span>
                                }
                                else if (item.Status == "error")
                                {
                                    <span class="upload-status-badge error">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <line x1="12" y1="8" x2="12" y2="12"></line>
                                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                        </svg>
                                        <span>Failed</span>
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (isUploading)
                {
                    <div class="upload-progress-container">
                        <div style="display:flex;justify-content:space-between;align-items:center;font-size:0.875rem;">
                            <span>Uploading book @currentUploadNumber of @totalToUpload...</span>
                            <strong>@((int)(uploadProgressRatio * 100))%</strong>
                        </div>
                        <div class="upload-progress-bar-bg">
                            <div class="upload-progress-bar-fill" style="width: @((int)(uploadProgressRatio * 100))%;"></div>
                        </div>
                    </div>
                }

                <div class="publish-submit-bar" style="margin-top:20px;">
                    <button type="button" class="btn-action-primary publish-btn" @onclick="UploadAllBooks" disabled="@(!CanUploadAll || isUploading)">
                        @if (isUploading)
                        {
                            <div class="btn-spinner"></div>
                            <span>Uploading Books...</span>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                            </svg>
                            <span>Upload @selectedItems.Count(i => i.Status == "ready" || i.Status == "error") Book@(selectedItems.Count == 1 ? "" : "s")</span>
                        }
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<UploadItemModel> selectedItems = new();
    private List<BookSubmission> uploadedSubmissions = new();
    private bool isUploading = false;
    private bool submittedSuccessfully = false;
    private int currentUploadNumber = 0;
    private int totalToUpload = 0;
    private double uploadProgressRatio => totalToUpload > 0 ? (double)currentUploadNumber / totalToUpload : 0;
    private string? errorMessage;

    private string authEmail = "";
    private string authPassword = "";
    private string? loginError;
    private bool isAuthenticating = false;

    private bool CanUploadAll => selectedItems.Any(i => i.Status == "ready" || i.Status == "error");

    private string TotalSelectedSizeText
    {
        get
        {
            long total = selectedItems.Sum(i => i.FileSize);
            if (total <= 0) return "0 MB";
            double mb = total / (1024.0 * 1024.0);
            if (mb >= 1.0) return $"{mb:F1} MB";
            double kb = total / 1024.0;
            return $"{kb:F0} KB";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Supabase.EnsureInitializedAsync();
        Supabase.AuthStateChanged += OnAuthStateChanged;
    }

    private void OnAuthStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Supabase.AuthStateChanged -= OnAuthStateChanged;
    }

    private async Task OnFilesSelected(ChangeEventArgs e)
    {
        errorMessage = null;
        try
        {
            var files = await Supabase.GetSelectedFilesInfoAsync("book-upload-input");
            if (files != null && files.Count > 0)
            {
                selectedItems = files.Select(f => new UploadItemModel
                {
                    Index = f.Index,
                    FileName = f.FileName,
                    FileSize = f.FileSize,
                    Title = CleanBookTitle(f.Title),
                    Status = "ready"
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error reading selected files: {ex.Message}";
        }
        StateHasChanged();
    }

    private string CleanBookTitle(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "Untitled Book";
        var title = raw.Replace("_", " ").Replace("-", " ").Trim();
        // Capitalize words
        var words = title.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        for (int i = 0; i < words.Length; i++)
        {
            if (words[i].Length > 1)
                words[i] = char.ToUpperInvariant(words[i][0]) + words[i].Substring(1);
            else if (words[i].Length == 1)
                words[i] = char.ToUpperInvariant(words[i][0]).ToString();
        }
        return string.Join(" ", words);
    }

    private void RemoveItem(UploadItemModel item)
    {
        selectedItems.Remove(item);
        StateHasChanged();
    }

    private void ClearSelected()
    {
        selectedItems.Clear();
        StateHasChanged();
    }

    private void ResetUploader()
    {
        selectedItems.Clear();
        uploadedSubmissions.Clear();
        submittedSuccessfully = false;
        errorMessage = null;
        StateHasChanged();
    }

    private async Task UploadAllBooks()
    {
        var itemsToUpload = selectedItems.Where(i => i.Status == "ready" || i.Status == "error").ToList();
        if (itemsToUpload.Count == 0) return;

        isUploading = true;
        errorMessage = null;
        currentUploadNumber = 0;
        totalToUpload = itemsToUpload.Count;

        try
        {
            foreach (var item in itemsToUpload)
            {
                currentUploadNumber++;
                item.Status = "uploading";
                item.ErrorMessage = null;
                StateHasChanged();

                // 1. Upload to Supabase Storage
                var uploadRes = await Supabase.UploadBookFileByIndexAsync("book-upload-input", item.Index, item.FileName);
                if (!uploadRes.Success || string.IsNullOrWhiteSpace(uploadRes.FilePath))
                {
                    item.Status = "error";
                    item.ErrorMessage = uploadRes.Error ?? "Storage upload failed";
                    StateHasChanged();
                    continue;
                }

                // 2. Create submission record in database
                var sub = new BookSubmission
                {
                    Title = !string.IsNullOrWhiteSpace(item.Title) ? item.Title.Trim() : item.FileName,
                    Author = "Unknown Author",
                    Category = "General",
                    Language = "English",
                    FileSize = uploadRes.FileSize > 0 ? uploadRes.FileSize : item.FileSize,
                    FilePath = uploadRes.FilePath,
                    PublicUrl = uploadRes.PublicUrl ?? "",
                    Status = "pending",
                    SubmitterEmail = Supabase.CurrentUser?.Email ?? "",
                    SubmitterName = Supabase.CurrentUser?.Email?.Split('@')[0] ?? "Anonymous",
                    SubmittedBy = Supabase.CurrentUser?.Id
                };

                var createRes = await Supabase.CreateSubmissionAsync(sub);
                if (createRes.Success)
                {
                    item.Status = "uploaded";
                    item.PublicUrl = uploadRes.PublicUrl;
                    uploadedSubmissions.Add(sub);
                }
                else
                {
                    item.Status = "error";
                    item.ErrorMessage = createRes.Error ?? "Database insert failed";
                }
                StateHasChanged();
            }

            if (selectedItems.All(i => i.Status == "uploaded"))
            {
                submittedSuccessfully = true;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Upload sequence error: {ex.Message}";
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private async Task HandleUserLogin()
    {
        isAuthenticating = true;
        loginError = null;
        try
        {
            var res = await Supabase.SignInAsync(authEmail.Trim(), authPassword);
            if (!res.Success)
            {
                loginError = res.Error ?? "Sign in failed. Check your credentials.";
            }
        }
        catch (Exception ex)
        {
            loginError = ex.Message;
        }
        finally
        {
            isAuthenticating = false;
        }
    }

    private async Task HandleUserSignUp()
    {
        if (string.IsNullOrWhiteSpace(authEmail) || string.IsNullOrWhiteSpace(authPassword))
        {
            loginError = "Please enter an email and password to sign up.";
            return;
        }

        isAuthenticating = true;
        loginError = null;
        try
        {
            var res = await Supabase.SignUpAsync(authEmail.Trim(), authPassword);
            if (!res.Success)
            {
                loginError = res.Error ?? "Sign up failed.";
            }
        }
        catch (Exception ex)
        {
            loginError = ex.Message;
        }
        finally
        {
            isAuthenticating = false;
        }
    }

    public class UploadItemModel
    {
        public int Index { get; set; }
        public string FileName { get; set; } = "";
        public long FileSize { get; set; }
        public string Title { get; set; } = "";
        public string Status { get; set; } = "ready";
        public string? ErrorMessage { get; set; }
        public string? PublicUrl { get; set; }

        public string FileSizeText
        {
            get
            {
                if (FileSize <= 0) return "-";
                double mb = FileSize / (1024.0 * 1024.0);
                if (mb >= 1.0) return $"{mb:F1} MB";
                double kb = FileSize / 1024.0;
                return $"{kb:F0} KB";
            }
        }
    }
}
