@page "/book/{Id:int}"
@implements IDisposable
@inject BookService Books

@if (!Books.IsLoaded && Books.LoadError is null)
{
    <PageTitle>Loading book - Aviv Library</PageTitle>
    <div class="book-detail-wrapper">
        <div class="skeleton-line short" style="margin-bottom:20px;"></div>
        <div class="skeleton-line medium" style="height:28px;margin-bottom:16px;"></div>
        <div class="skeleton-row" style="margin-bottom:20px;border-radius:6px;border:1px solid var(--border-default);">
            <div class="skeleton-body">
                <div class="skeleton-line medium"></div>
                <div class="skeleton-line short"></div>
            </div>
        </div>
    </div>
}
else if (book is null)
{
    <PageTitle>Book not found - Aviv Library</PageTitle>
    <div class="not-found-card">
        <h1 class="page-title">Book not found</h1>
        <p class="muted">There is no book with ID #@Id.</p>
        <p><a href="/" class="btn-read">← Return to library</a></p>
    </div>
}
else
{
    <PageTitle>@book.Title - Aviv Library</PageTitle>

    <div class="book-detail-wrapper">
        <nav class="book-breadcrumb">
            <a href="/">← Library</a>
            <span class="crumb-separator">/</span>
            <span class="crumb-current">@book.Title</span>
        </nav>

        <header class="book-header">
            <h1 class="book-hero-title">@book.Title</h1>
            <div class="book-meta-bar">
                <span class="meta-pill">PDF Document</span>
                <span class="meta-pill">@book.FileSizeText</span>
                @if (Books.GetDownloads(book.Id) is int dl && dl > 0)
                {
                    <span class="meta-pill downloads-pill">@dl.ToString("N0") downloads</span>
                }
                @if (book.HasAuthor)
                {
                    <span class="meta-author">by <strong>@book.Author</strong></span>
                }
            </div>
        </header>

        <section class="book-card-primary">
            <div class="book-card-content">
                <div class="book-card-info">
                    <h3>Direct Download</h3>
                    <p class="muted">Complete, unaltered PDF. Free forever, no account, no tracking.</p>
                </div>
            </div>

            <div class="book-action-buttons">
                <a class="btn-action-primary" href="/api/download?id=@book.Id" download>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    <span>Download PDF (@book.FileSizeText)</span>
                </a>
                <a class="btn-action-secondary" href="/api/download?id=@book.Id&view=1" target="_blank" rel="noopener noreferrer">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                    <span>Read in Browser</span>
                </a>
            </div>
        </section>

        @if (book.HasDescription)
        {
            <section class="book-description-box">
                <h2>About this book</h2>
                <p>@book.Description</p>
            </section>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private Book? book;

    protected override void OnInitialized()
    {
        Books.StatsChanged += OnUpdate;
        Books.LoadedChanged += OnUpdate;
    }

    protected override void OnParametersSet() => book = Books.GetById(Id);

    private void OnUpdate()
    {
        book = Books.GetById(Id);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Books.StatsChanged -= OnUpdate;
        Books.LoadedChanged -= OnUpdate;
    }
}
