@using WikiLibrary.Models
@inject BookService BookService

@if (Books.Count == 0)
{
    <div class="empty-books-state">
        <p class="muted">No books found in this selection.</p>
    </div>
}
else
{
    <div class="book-list-container">
        @foreach (var b in Books)
        {
            <article class="book-row">
                <a href="/book/@b.Id" class="book-row-main" title="View details for @b.Title">
                    <div class="book-details">
                        <h3 class="book-title">@b.Title</h3>
                        <div class="book-meta">
                            <span class="book-badge">PDF</span>
                            <span class="book-size">@b.FileSizeText</span>
                            @if (BookService.GetDownloads(b.Id) is int count && count > 0)
                            {
                                <span class="book-downloads">@count.ToString("N0") downloads</span>
                            }
                            @if (b.HasCategory)
                            {
                                <span class="book-badge">@b.Category</span>
                            }
                            @if (b.HasAuthor)
                            {
                                <span class="book-author">by @b.Author</span>
                            }
                        </div>
                    </div>
                </a>
                <div class="book-actions">
                    <a href="/api/download?id=@b.Id" download class="btn-download" title="Direct download PDF">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        <span>Download</span>
                    </a>
                    <a href="/book/@b.Id" class="btn-read">
                        <span>Details</span>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </a>
                </div>
            </article>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Book> Books { get; set; } = Array.Empty<Book>();
}
