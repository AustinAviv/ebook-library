@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject BookService Books
@inject SupabaseService Supabase

<header class="topbar">
    <a class="brand" href="/">
        <span>Aviv Library</span>
    </a>

    <div class="topbar-center">
        <form class="searchbox" @onsubmit="Submit" @onsubmit:preventDefault>
            <div class="search-input-wrapper">
                <span class="search-icon-prefix" aria-hidden="true">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </span>
                <input type="search" placeholder="Search by title, author, or keyword..."
                       aria-label="Search books"
                       value="@query"
                       @oninput="OnQueryInput"
                       @onfocus="OnInputFocus"
                       @onblur="OnInputBlur"
                       @onkeydown="OnKeyDown" />
                @if (isOpen && !string.IsNullOrWhiteSpace(query))
                {
                    <div class="search-dropdown" @onmousedown:preventDefault>
                        @if (searchResults.Count > 0)
                        {
                            <div class="search-dropdown-header">
                                <span>Matching Books (@searchResults.Count)</span>
                                <span class="search-dropdown-shortcut">ESC to close</span>
                            </div>
                            <ul class="search-dropdown-list">
                                @for (int i = 0; i < searchResults.Count; i++)
                                {
                                    var book = searchResults[i];
                                    var isSelected = i == selectedIndex;
                                    <li class="search-dropdown-item @(isSelected ? "selected" : "")">
                                        <a href="/book/@book.Id" @onclick="() => SelectBook(book.Id)">
                                            <div class="search-item-info">
                                                <span class="search-item-title">@book.Title</span>
                                                <span class="search-item-author">@(book.HasAuthor ? book.Author : "Unknown Author")</span>
                                            </div>
                                            <div class="search-item-meta">
                                                @if (book.HasCategory)
                                                {
                                                    <span class="search-item-category">@book.Category</span>
                                                }
                                                <span class="search-item-size">@book.FileSizeText</span>
                                            </div>
                                        </a>
                                    </li>
                                }
                            </ul>
                            <div class="search-dropdown-footer">
                                <button type="button" class="search-view-all-btn" @onclick="Submit">
                                    <span>View all search results for "@query"</span>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="9 18 15 12 9 6"></polyline>
                                    </svg>
                                </button>
                            </div>
                        }
                        else if (query.Trim().Length >= 2)
                        {
                            <div class="search-dropdown-empty">
                                <p>No books found matching "<strong>@query</strong>"</p>
                                <span class="search-empty-tip">Try searching by topic, language, or author name.</span>
                            </div>
                        }
                    </div>
                }
            </div>
            <button type="submit">Search</button>
        </form>
    </div>

    <div class="topbar-actions">
        <a href="/publish" class="topbar-publish-btn" title="Submit a Book to the Library">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            <span>Submit Book</span>
        </a>

        @if (Supabase.IsAuthenticated)
        {
            <div class="user-pill-dropdown">
                <span class="user-email-pill" title="@Supabase.CurrentUser?.Email">
                    @(Supabase.IsOwner ? "👑 Owner" : (Supabase.CurrentUser?.Email?.Split('@')[0] ?? "User"))
                </span>
                <button type="button" class="btn-signout" @onclick="Supabase.SignOutAsync" title="Sign Out">
                    Sign Out
                </button>
            </div>
        }
        else
        {
            <button type="button" class="topbar-auth-btn" @onclick="() => authModal?.Show(false)">
                Sign In
            </button>
        }

        <button class="theme-toggle-btn" @onclick="ToggleTheme" title="Toggle dark/light theme" aria-label="Toggle theme">
            @if (isDark)
            {
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>
            }
            else
            {
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
            }
        </button>
    </div>
</header>

<div class="page">
    <aside class="sidebar" aria-label="Navigation">
        <div class="sidebar-section">
            <h3 class="sidebar-heading">Navigation</h3>
            <ul class="sidebar-menu">
                <li>
                    <NavLink href="" Match="NavLinkMatch.All">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        <span>Library</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="random">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="16 3 21 3 21 8"></polyline>
                            <line x1="4" y1="20" x2="21" y2="3"></line>
                            <polyline points="21 16 21 21 16 21"></polyline>
                            <line x1="15" y1="15" x2="21" y2="21"></line>
                            <line x1="4" y1="4" x2="9" y2="9"></line>
                        </svg>
                        <span>Random Book</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="publish">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="17 8 12 3 7 8"></polyline>
                            <line x1="12" y1="3" x2="12" y2="15"></line>
                        </svg>
                        <span>Submit a Book</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="my-submissions">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                        <span>My Submissions</span>
                    </NavLink>
                </li>
                @if (Supabase.IsOwner)
                {
                    <li class="sidebar-item-owner">
                        <NavLink href="admin/reviews">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                            </svg>
                            <span>Owner Review Portal</span>
                        </NavLink>
                    </li>
                }
                <li>
                    <NavLink href="about">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        <span>Architecture & Stack</span>
                    </NavLink>
                </li>
            </ul>
        </div>

        <div class="sidebar-section">
            <h3 class="sidebar-heading">Collection</h3>
            <div class="sidebar-stats-box">
                <span class="sidebar-stat-number">@Books.Count</span>
                <span class="sidebar-stat-label">Indexed PDF Books</span>
            </div>
        </div>

        <div class="sidebar-section">
            <h3 class="sidebar-heading">Tech Stack</h3>
            <div class="sidebar-tech-stack">
                <a href="/about" class="sidebar-tech-badge">.NET 10</a>
                <a href="/about" class="sidebar-tech-badge">C# 13</a>
                <a href="/about" class="sidebar-tech-badge">Blazor WASM</a>
                <a href="/about" class="sidebar-tech-badge">Vercel Edge</a>
                <a href="/about" class="sidebar-tech-badge">Upstash Redis</a>
                <a href="/about" class="sidebar-tech-badge">Vanilla CSS</a>
            </div>
        </div>
    </aside>

    <main class="content">
        @Body
    </main>
</div>

<footer class="footer">
    <span>Aviv Library - Open digital archive for free PDF books. No account required.</span>
    <div class="footer-tech">
        <a href="/about" style="color:inherit;">Stack: Blazor WebAssembly (.NET 10 / C# 13) | Vercel Edge | Upstash Redis</a>
    </div>
</footer>

<AuthModal @ref="authModal" OnAuthSuccess="HandleAuthSuccess" />

@code {
    private AuthModal? authModal;
    private string query = "";
    private bool isDark = false;
    private bool isOpen = false;
    private int selectedIndex = -1;
    private List<Book> searchResults = new();

    protected override void OnInitialized()
    {
        Books.LoadedChanged += OnLoaded;
        Nav.LocationChanged += OnLocationChanged;
        Supabase.AuthStateChanged += OnAuthStateChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await Supabase.EnsureInitializedAsync();
        StateHasChanged();
    }

    private void OnAuthStateChanged() => InvokeAsync(StateHasChanged);
    private void HandleAuthSuccess() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        isOpen = false;
        StateHasChanged();
    }

    private void OnLoaded() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Books.LoadedChanged -= OnLoaded;
        Nav.LocationChanged -= OnLocationChanged;
        Supabase.AuthStateChanged -= OnAuthStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("getTheme");
                isDark = theme == "dark";
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task ToggleTheme()
    {
        try
        {
            var nextTheme = await JS.InvokeAsync<string>("toggleTheme");
            isDark = nextTheme == "dark";
        }
        catch { }
    }

    private void OnQueryInput(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? "";
        selectedIndex = -1;
        if (query.Trim().Length >= 1)
        {
            searchResults = Books.Search(query).Take(5).ToList();
            isOpen = true;
        }
        else
        {
            searchResults.Clear();
            isOpen = false;
        }
    }

    private void OnInputFocus()
    {
        if (query.Trim().Length >= 1)
        {
            searchResults = Books.Search(query).Take(5).ToList();
            isOpen = true;
        }
    }

    private void OnInputBlur()
    {
        isOpen = false;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (!isOpen)
        {
            if (e.Key == "ArrowDown" && query.Trim().Length >= 1)
            {
                searchResults = Books.Search(query).Take(5).ToList();
                isOpen = true;
                selectedIndex = 0;
            }
            return;
        }

        if (e.Key == "ArrowDown")
        {
            if (searchResults.Count > 0)
            {
                selectedIndex = (selectedIndex + 1) % searchResults.Count;
            }
        }
        else if (e.Key == "ArrowUp")
        {
            if (searchResults.Count > 0)
            {
                selectedIndex = (selectedIndex - 1 + searchResults.Count) % searchResults.Count;
            }
        }
        else if (e.Key == "Escape")
        {
            isOpen = false;
            selectedIndex = -1;
        }
        else if (e.Key == "Enter")
        {
            if (selectedIndex >= 0 && selectedIndex < searchResults.Count)
            {
                SelectBook(searchResults[selectedIndex].Id);
            }
            else
            {
                Submit();
            }
        }
    }

    private void SelectBook(int id)
    {
        isOpen = false;
        query = "";
        Nav.NavigateTo($"/book/{id}");
    }

    private void Submit()
    {
        var q = query.Trim();
        isOpen = false;
        if (q.Length > 0)
            Nav.NavigateTo($"/search?q={Uri.EscapeDataString(q)}");
    }
}
