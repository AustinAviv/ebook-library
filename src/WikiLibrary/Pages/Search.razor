@page "/search"
@implements IDisposable
@inject BookService Books

<PageTitle>Search: @Query - Aviv Library</PageTitle>
<h1 class="page-title">Search Results</h1>

@if (!Books.IsLoaded && Books.LoadError is null)
{
    <p class="muted count-info">Searching catalogue...</p>
    <div class="book-grid">
        @for (int i = 0; i < 6; i++)
        {
            <div class="skeleton-card">
                <div class="skeleton-line short"></div>
                <div class="skeleton-line medium" style="height:20px;"></div>
                <div class="skeleton-line" style="width:50%;"></div>
                <div class="skeleton-line short" style="margin-top:auto;"></div>
                <div style="display:flex;gap:8px;padding-top:12px;border-top:1px solid var(--border-default);">
                    <div class="skeleton-line" style="flex:1;height:32px;"></div>
                    <div class="skeleton-line" style="width:68px;height:32px;"></div>
                </div>
            </div>
        }
    </div>
}
else if (string.IsNullOrWhiteSpace(Query))
{
    <p class="muted">Type a book title in the search box above to search.</p>
}
else
{
    <p class="muted count-info">
        @total.ToString("N0") result@(total == 1 ? "" : "s") for "<strong style="color:var(--text-primary)">@Query</strong>"
    </p>
    <BookList Books="pageItems" />
    <Pager TotalItems="total" CurrentPage="Math.Max(PageNo ?? 1, 1)" PageSize="BookService.PageSize" />
}

@code {
    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "page")] public int? PageNo { get; set; }

    private int total;
    private IReadOnlyList<Book> pageItems = Array.Empty<Book>();

    protected override void OnInitialized()
    {
        Books.LoadedChanged += OnLoaded;
    }

    private void OnLoaded()
    {
        UpdateResults();
        InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        UpdateResults();
    }

    private void UpdateResults()
    {
        var results = Books.Search(Query ?? "");
        total = results.Count;
        pageItems = BookService.Page(results, PageNo ?? 1);
    }

    public void Dispose()
    {
        Books.LoadedChanged -= OnLoaded;
    }
}
