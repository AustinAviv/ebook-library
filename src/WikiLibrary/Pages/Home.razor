@page "/"
@implements IDisposable
@inject BookService Books

<PageTitle>Aviv Library - Open Digital Archive</PageTitle>

@if (Books.LoadError is not null)
{
    <div class="alert-error" role="alert" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
        <span>The library catalogue could not be loaded: @Books.LoadError</span>
        <button type="button" class="btn-read" @onclick="Retry" style="padding:4px 12px;font-size:0.8125rem;">Retry</button>
    </div>
}
else if (!Books.IsLoaded)
{
    <h1 class="firstHeading">Welcome to Aviv Library</h1>
    <p class="muted" style="margin-bottom:1.8em;font-size:1.05rem;line-height:1.7;">
        An open digital archive of free PDF books that anyone can read and download. Free forever, no registration, no tracking.
    </p>

    <div class="section-header-row" style="display:flex;justify-content:space-between;align-items:baseline;margin-top:1.5em;margin-bottom:12px;">
        <h2 class="section-title" style="margin:0;border:none;">Loading Books...</h2>
    </div>

    <div class="book-grid">
        @for (int i = 0; i < 6; i++)
        {
            <div class="skeleton-card">
                <div class="skeleton-line short"></div>
                <div class="skeleton-line medium" style="height:20px;"></div>
                <div class="skeleton-line" style="width:50%;"></div>
                <div class="skeleton-line short" style="margin-top:auto;"></div>
                <div style="display:flex;gap:8px;padding-top:12px;border-top:1px solid var(--border-default);">
                    <div class="skeleton-line" style="flex:1;height:32px;"></div>
                    <div class="skeleton-line" style="width:68px;height:32px;"></div>
                </div>
            </div>
        }
    </div>
}
else
{
    <h1 class="firstHeading">Welcome to Aviv Library</h1>
    <p class="muted" style="margin-bottom:1.8em;font-size:1.05rem;line-height:1.7;">
        An open digital archive of <strong>@Books.Count.ToString("N0") PDF books</strong> that anyone can read and download.
        Free forever, no registration, no tracking.
    </p>

    <div class="section-header-row" style="display:flex;justify-content:space-between;align-items:baseline;margin-top:1.5em;margin-bottom:12px;">
        <h2 class="section-title" style="margin:0;border:none;">Available Books</h2>
        <span class="muted">Showing @pageItems.Count of @total book@(total == 1 ? "" : "s")</span>
    </div>

    <BookList Books="pageItems" />
    <Pager TotalItems="total" CurrentPage="Math.Max(PageNo ?? 1, 1)" PageSize="BookService.PageSize" />
}

@code {
    [Parameter, SupplyParameterFromQuery(Name = "page")] public int? PageNo { get; set; }

    private int total;
    private IReadOnlyList<Book> pageItems = Array.Empty<Book>();

    protected override void OnInitialized()
    {
        Books.LoadedChanged += OnLoaded;
    }

    private void OnLoaded()
    {
        UpdatePage();
        InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        UpdatePage();
    }

    private void UpdatePage()
    {
        total = Books.Count;
        pageItems = BookService.Page(Books.All, PageNo ?? 1, BookService.PageSize);
    }

    private async Task Retry() => await Books.RetryAsync();

    public void Dispose()
    {
        Books.LoadedChanged -= OnLoaded;
    }
}
