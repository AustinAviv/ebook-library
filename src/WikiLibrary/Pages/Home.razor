@page "/"
@inject BookService Books

<PageTitle>Free Library — Open Digital Archive</PageTitle>

@if (Books.LoadError is not null)
{
    <div class="alert-error" role="alert">
        The library catalogue could not be loaded: @Books.LoadError
    </div>
}
else
{
    <h1 class="firstHeading">Welcome to Free Library</h1>
    <p class="muted" style="margin-bottom:1.8em;font-size:1.05rem;line-height:1.7;">
        An open digital archive of <strong>@Books.Count.ToString("N0") PDF books</strong> that anyone can read and download.
        Free forever, no registration, no tracking.
    </p>

    <div class="section-header-row" style="display:flex;justify-content:space-between;align-items:baseline;margin-top:1.5em;">
        <h2 class="section-title" style="margin:0;border:none;">Available Books</h2>
        <span class="muted">@Books.Count book@(Books.Count == 1 ? "" : "s")</span>
    </div>

    <BookList Books="Books.All" />
}
