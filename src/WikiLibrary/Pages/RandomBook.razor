@page "/random"
@inject BookService Books
@inject NavigationManager Nav

<p>Finding a random book…</p>

@code {
    // Jump straight to a random book; "replace" keeps the Back button useful.
    protected override void OnInitialized()
    {
        var b = Books.RandomBook();
        Nav.NavigateTo(b is null ? "/" : $"/book/{b.Id}", replace: true);
    }
}
