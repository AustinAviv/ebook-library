@inherits LayoutComponentBase
@inject NavigationManager Nav

<header class="topbar">
    <a class="brand" href="/">
        <img src="logo.svg" alt="Free Library" width="34" height="34" />
        <span>Free Library</span>
    </a>
    <form class="searchbox" @onsubmit="Submit" @onsubmit:preventDefault>
        <input type="search" placeholder="Search by book name…"
               aria-label="Search" @bind="query" @bind:event="oninput" />
        <button type="submit">Search</button>
    </form>
</header>

<div class="page">
    <aside class="sidebar" aria-label="Navigation">
        <h3 class="sidebar-heading">Navigation</h3>
        <ul class="sidebar-menu">
            <li><a href="/">Library</a></li>
            <li><a href="/random">Random Book</a></li>
            <li><a href="/a-z">All Books (A–Z)</a></li>
            <li><a href="/about">About</a></li>
        </ul>
    </aside>

    <main class="content">
        @Body
    </main>
</div>

<footer class="footer">
    <p>Free Library — an open collection of PDF books. Free forever, no registration needed.</p>
</footer>

@code {
    private string query = "";

    private void Submit()
    {
        var q = query.Trim();
        if (q.Length > 0)
            Nav.NavigateTo($"/search?q={Uri.EscapeDataString(q)}");
    }
}
