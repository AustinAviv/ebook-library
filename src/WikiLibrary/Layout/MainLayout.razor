@inherits LayoutComponentBase
@inject NavigationManager Nav

<header class="topbar">
    <a class="brand" href="/">
        <img src="logo.svg" alt="" width="36" height="36" />
        <span>Free Library</span>
    </a>
    <form class="searchbox" @onsubmit="Submit" @onsubmit:preventDefault>
        <input type="search" placeholder="Search books, authors, categories"
               aria-label="Search" @bind="query" @bind:event="oninput" />
        <button type="submit">Search</button>
    </form>
</header>

<div class="page">
    <nav class="sidebar" aria-label="Navigation">
        <h3>Navigation</h3>
        <ul>
            <li><a href="/">Main page</a></li>
            <li><a href="/random">Random book</a></li>
            <li><a href="/categories">Categories</a></li>
            <li><a href="/a-z">All books (A–Z)</a></li>
            <li><a href="/about">About</a></li>
        </ul>
    </nav>

    <main class="content">
        @Body
    </main>
</div>

<footer class="footer">
    <p>Free Library is a free, no-login collection of PDF books. Files are provided as-is.</p>
    <p>Styled after Wikipedia for readability; not affiliated with Wikipedia or the Wikimedia Foundation.</p>
</footer>

@code {
    private string query = "";

    private void Submit()
    {
        var q = query.Trim();
        if (q.Length > 0)
            Nav.NavigateTo($"/search?q={Uri.EscapeDataString(q)}");
    }
}
