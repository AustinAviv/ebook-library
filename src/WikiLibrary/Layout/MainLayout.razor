@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject BookService Books

<header class="topbar">
    <a class="brand" href="/">
        <span>Aviv Library</span>
    </a>

    <div class="topbar-center">
        <form class="searchbox" @onsubmit="Submit" @onsubmit:preventDefault>
            <div class="search-input-wrapper">
                <span class="search-icon-prefix" aria-hidden="true">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </span>
                <input type="search" placeholder="Search by title, author, or keyword..."
                       aria-label="Search books" @bind="query" @bind:event="oninput" />
            </div>
            <button type="submit">Search</button>
        </form>
    </div>

    <div class="topbar-actions">
        <button class="theme-toggle-btn" @onclick="ToggleTheme" title="Toggle dark/light theme" aria-label="Toggle theme">
            @if (isDark)
            {
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>
            }
            else
            {
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
            }
        </button>
    </div>
</header>

<div class="page">
    <aside class="sidebar" aria-label="Navigation">
        <div class="sidebar-section">
            <h3 class="sidebar-heading">Navigation</h3>
            <ul class="sidebar-menu">
                <li>
                    <NavLink href="" Match="NavLinkMatch.All">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        <span>Library</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="random">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="16 3 21 3 21 8"></polyline>
                            <line x1="4" y1="20" x2="21" y2="3"></line>
                            <polyline points="21 16 21 21 16 21"></polyline>
                            <line x1="15" y1="15" x2="21" y2="21"></line>
                            <line x1="4" y1="4" x2="9" y2="9"></line>
                        </svg>
                        <span>Random Book</span>
                    </NavLink>
                </li>
                <li>
                    <NavLink href="about">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        <span>Architecture & Stack</span>
                    </NavLink>
                </li>
            </ul>
        </div>

        <div class="sidebar-section">
            <h3 class="sidebar-heading">Collection</h3>
            <div class="sidebar-stats-box">
                <span class="sidebar-stat-number">@Books.Count</span>
                <span class="sidebar-stat-label">Indexed PDF Books</span>
            </div>
        </div>

        <div class="sidebar-section">
            <h3 class="sidebar-heading">Tech Stack</h3>
            <div class="sidebar-tech-stack">
                <a href="/about" class="sidebar-tech-badge">.NET 10</a>
                <a href="/about" class="sidebar-tech-badge">C# 13</a>
                <a href="/about" class="sidebar-tech-badge">Blazor WASM</a>
                <a href="/about" class="sidebar-tech-badge">Vercel Edge</a>
                <a href="/about" class="sidebar-tech-badge">Upstash Redis</a>
                <a href="/about" class="sidebar-tech-badge">Vanilla CSS</a>
            </div>
        </div>
    </aside>

    <main class="content">
        @Body
    </main>
</div>

<footer class="footer">
    <span>Aviv Library - Open digital archive for free PDF books. No account required.</span>
    <div class="footer-tech">
        <a href="/about" style="color:inherit;">Stack: Blazor WebAssembly (.NET 10 / C# 13) | Vercel Edge | Upstash Redis</a>
    </div>
</footer>

@code {
    private string query = "";
    private bool isDark = false;

    protected override void OnInitialized()
    {
        Books.LoadedChanged += OnLoaded;
    }

    private void OnLoaded() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Books.LoadedChanged -= OnLoaded;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("getTheme");
                isDark = theme == "dark";
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task ToggleTheme()
    {
        try
        {
            var nextTheme = await JS.InvokeAsync<string>("toggleTheme");
            isDark = nextTheme == "dark";
        }
        catch { }
    }

    private void Submit()
    {
        var q = query.Trim();
        if (q.Length > 0)
            Nav.NavigateTo($"/search?q={Uri.EscapeDataString(q)}");
    }
}
